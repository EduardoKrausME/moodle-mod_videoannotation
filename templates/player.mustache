{{!
    @template mod_videoannotation/player
}}
<div class="videoannotation-player" data-region="player-container">
    {{#player.ishtml5}}
        <video class="videoannotation-player__video" data-region="html5-player" controls preload="metadata"
               {{#player.disabledownload}}controlslist="nodownload"{{/player.disabledownload}}
            {{#player.disablepip}}disablepictureinpicture{{/player.disablepip}}>
            <source src="{{{player.url}}}">
        </video>
    {{/player.ishtml5}}
    {{#player.isyoutube}}
        <div id="videoannotation-youtube-player" class="videoannotation-player__embed"
             data-region="youtube-player"></div>
    {{/player.isyoutube}}
    {{#player.isvimeo}}
        <div id="videoannotation-vimeo-player" class="videoannotation-player__embed" data-region="vimeo-player"></div>
    {{/player.isvimeo}}
</div>
